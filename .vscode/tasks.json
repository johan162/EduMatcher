{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "EduMatcher: Build",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/mkbld.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "EduMatcher: Release",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/mkrelease.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "EduMatcher: Switch to main",
            "type": "shell",
            "command": "git",
            "args": [
                "switch",
                "main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "EduMatcher: GitHub Release",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/mkghrelease.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "EduMatcher: Switch to main",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}