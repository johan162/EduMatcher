# EduMatcher — written to .env by the installer, edit and re-run
# './edumatcher.sh restart' to apply.

# Which release to run. A version pins the whole system to one coherent set of
# images (all five carry the same tag); 'latest' follows the newest release.
EM_VERSION=latest

# GHCR namespace the images are pulled from.
GHCR_OWNER=johan162

# The engine configuration to deploy. A bundled example name:
#   one-basic  three-basic  ten-basic  thirty-basic
#   ...and each of those as -nominal and -complex
# Change it with './edumatcher.sh config <name>' rather than by hand, so the
# EM_CONFIG_FILE line below is kept consistent.
EM_CONFIG=three-basic

# Set by './edumatcher.sh config <file>' when running a configuration of your
# own. Non-empty means the file in ./config wins over EM_CONFIG above.
EM_CONFIG_FILE=

# Which processes to run: default (full stack), mini, or micro.
EM_PROFILE=default

# Container timezone — set it to match the trading calendar in your
# configuration, e.g. TZ=Europe/Stockholm.
TZ=UTC

# Host interface the published ports bind to. 127.0.0.1 keeps the exchange
# reachable from this machine only; 0.0.0.0 opens it to your local network.
# The gateways have no authentication, so think before changing this.
BIND_ADDR=127.0.0.1

# Host ports for the web GUIs.
TERMINAL_GUI_PORT=8090
LOG_GUI_PORT=8091
CONFIG_GUI_PORT=8092
TRADER_GUI_PORT=8093
