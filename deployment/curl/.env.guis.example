# EduMatcher web GUIs for an exchange you run yourself (pipx) — written to .env
# by the installer ('install.sh --guis'). Edit and apply with
# './edumatcher.sh restart'.

# Which compose file ./edumatcher.sh drives. 'guis' means compose.guis.yaml:
# the six web GUIs, no exchange. Do not change it.
EM_STACK=guis

# Which release of the GUI images to run. Use the same version as the pipx
# package ('pm-engine --version'); 'latest' follows the newest release.
EM_VERSION=latest

# GHCR namespace the images are pulled from.
GHCR_OWNER=johan162

# The exchange's data directory — the one pm-setup printed, and the one your
# pm-* commands use. log-gui and dash-gui read log.db, metrics.db and the
# deployed configuration from it, read-only. EDUMATCHER_DATA_DIR in the shell
# that runs './edumatcher.sh start' wins over this line.
#EM_DATA_DIR=/home/you/.local/share/edumatcher

# How the GUI containers address the machine the exchange runs on. Compose maps
# the name to the host with host-gateway. Change it only if that name clashes
# with something on your system.
#EM_HOST=host.docker.internal

# Host interface the GUIs' published ports bind to. 127.0.0.1 keeps them
# reachable from this machine only.
BIND_ADDR=127.0.0.1

# Host ports for the web GUIs.
TERMINAL_GUI_PORT=8090
LOG_GUI_PORT=8091
CONFIG_GUI_PORT=8092
TRADER_GUI_PORT=8093
BOOK_GUI_PORT=8094
DASH_GUI_PORT=8095

# Where the operator dashboard's drawers link to log-gui and book-gui, as your
# browser reaches them. Default: http://localhost:<LOG_GUI_PORT> and
# http://localhost:<BOOK_GUI_PORT>. Set these when you open the GUIs from
# another machine (BIND_ADDR=0.0.0.0).
#LOG_GUI_URL=http://exchange.example:8091
#BOOK_GUI_URL=http://exchange.example:8094
