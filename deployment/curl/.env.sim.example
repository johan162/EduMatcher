# EduMatcher AI-trader simulation — written to .env by the installer
# ('install.sh --sim'). Edit and apply with './edumatcher.sh restart'.

# Which compose file ./edumatcher.sh drives. 'sim' means compose.ai-sim.yaml;
# anything else means the plain exchange's compose.yaml. Do not change it.
EM_STACK=sim

# Which release to run. A version pins the whole system to one coherent set of
# images (all five carry the same tag); 'latest' follows the newest release.
EM_VERSION=latest

# GHCR namespace the images are pulled from.
GHCR_OWNER=johan162

# How many times faster than the wall clock the trading calendar runs.
# 1 = real time (09:00-16:05, Monday-Friday); 24 = one trading day an hour.
EM_SPEED=1

# Where an accelerated calendar starts, local time, e.g. 2026-11-02T08:55.
# Empty = now. It applies again at every restart.
EM_START=

# Set by './edumatcher.sh config <file>' when running a configuration of your
# own. Non-empty means the file in ./config is deployed instead of s300-sim;
# a market_sim.yaml next to it is deployed with it.
EM_CONFIG_FILE=

# The trading calendar's time zone — the scheduler works in local time.
TZ=Europe/Stockholm

# Host interface the published ports bind to. 127.0.0.1 keeps the simulation
# reachable from this machine only; 0.0.0.0 opens it to your local network.
# The order gateways have no authentication, so think before changing this.
BIND_ADDR=127.0.0.1

# Bind host for the service-layer listeners inside the container. 0.0.0.0 is
# what makes them reachable from the sibling GUI containers.
EDUMATCHER_GATEWAY_BIND_HOST=0.0.0.0

# The read-only API key the market-data GUIs use. The default is the s300-sim
# example's; change it only together with a configuration of your own.
PM_READONLY_API_KEY=key-readonly-9vaho7

# Host ports for the web GUIs.
TERMINAL_GUI_PORT=8090
LOG_GUI_PORT=8091
TRADER_GUI_PORT=8093
BOOK_GUI_PORT=8094
