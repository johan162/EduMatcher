# Copied to .env by `make init` (or by the first `make build`/`make up`).
# Every value here is a default; nothing needs changing for a working system.

# Compose project name — decides container, image and network naming.
COMPOSE_PROJECT_NAME=edumatcher

# --- What to install ------------------------------------------------------
# Empty = latest release on PyPI. Pin a release for a reproducible image,
# e.g. EDUMATCHER_VERSION=0.20.2. Ignored when building with `make build DEV=1`,
# which installs the wheel from ../dist instead.
EDUMATCHER_VERSION=

# Set to 0 to build a smaller image with no openssh-server. `make up SSH=1`
# then has nothing to start.
WITH_SSH=1

# --- Runtime --------------------------------------------------------------
# Bundled example configuration to deploy, resolved exactly as
# `pm-config-deploy --example` resolves it:
#   one-basic  three-basic  ten-basic  thirty-basic
#   ...-nominal  ...-complex
# Changing this and running `make up` redeploys the configuration in ./data.
EM_CONFIG=three-basic

# pm-opctl-cli profile to start: default (full stack), mini, or micro.
EM_PROFILE=default

# Container timezone. Set it to match the trading calendar in the engine
# configuration, e.g. TZ=Europe/Stockholm.
TZ=Europe/Stockholm

# --- Exposure -------------------------------------------------------------
# Host interface the published ports bind to. 127.0.0.1 keeps the exchange
# reachable from this machine only; 0.0.0.0 opens it to the local network.
BIND_ADDR=127.0.0.1

# Host port forwarded to sshd in the container (make up SSH=1).
SSH_PORT=2222

# Host ports the web GUIs are published on by `make up-all`. They reach the
# exchange over the compose network, not through these ports.
TERMINAL_GUI_PORT=8090
LOG_GUI_PORT=8091
CONFIG_GUI_PORT=8092
TRADER_GUI_PORT=8093

# --- Naming ---------------------------------------------------------------
IMAGE_NAME=edumatcher
IMAGE_TAG=local
CONTAINER_NAME=edumatcher
