# pm-clearing-ui environment. Copy to .env (git-ignored) to override the
# defaults; docker compose reads it. Every variable is optional.

# Host port the container publishes (container port is fixed at 8096).
CLEARING_GUI_PORT=8096

# Where /api/* is forwarded: pm-api-gwy's HTTP address, as seen from the
# container (Docker Desktop: host.docker.internal; Podman:
# host.containers.internal). For `npm run serve` outside a container, e.g.
# http://localhost:8080. Unset: /api/* answers 503 with an explanation.
API_PROXY_TARGET=http://host.docker.internal:8080
