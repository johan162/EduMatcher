{
  "name": "edumatcher-log-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based operator console for pm-log-srv (pm-log-ui).",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @edumatcher/log-bridge & npm run dev --workspace @edumatcher/log-web",
    "dev:web": "npm run dev --workspace @edumatcher/log-web",
    "dev:bridge": "npm run dev --workspace @edumatcher/log-bridge",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "npm run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
