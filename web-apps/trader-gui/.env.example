# EduMatcher Trading GUI — environment variables (§22.1)
# Copy to .env and adjust for your local setup.

# Base URL for pm-api-gwy REST API (no trailing slash).
# In development, the Vite proxy forwards /api/* so this can stay empty.
VITE_API_BASE=

# Base URL for WebSocket connections (ws:// or wss://).
# In development, the Vite proxy handles WS upgrades — leave empty.
VITE_WS_BASE=

# Browser tab title and top-bar wordmark.
VITE_APP_TITLE=EduMatcher Trading

# Maximum symbols in the broad book/trades subscription item (Market Overview).
VITE_MAX_OVERVIEW_SYMBOLS=250

# Maximum active/watchlist symbols in the narrow depth/auction subscription item.
VITE_MAX_FOCUS_SYMBOLS=25

# Number of historical ticks to fetch for intraday charts.
VITE_CHART_HISTORY_TICKS=1000

# Duration of price flash animation in milliseconds (§17.3.3).
VITE_FLASH_DURATION_MS=500

# How often the Market Overview re-derives its rows from the book store.
# The engine republishes a full book per symbol about every 0.5s, so this
# bounds table re-render work independently of the symbol count (§17.3.4).
VITE_MARKET_THROTTLE_MS=250

# Maximum WebSocket reconnect backoff delay in milliseconds.
VITE_WS_RECONNECT_MAX_DELAY=30000

# Maximum entries retained in the Notification / Event Center.
VITE_NOTIFICATION_BUFFER=500
