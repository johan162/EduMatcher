{
  "name": "edumatcher-trader-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Graphical trading terminal for EduMatcher (pm-trading-ui) — TRADER, MARKET_MAKER and ADMIN roles.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @edumatcher/trader-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "npm run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
