    {"name": "audit", "command": ["pm-audit", "--verbose"]},
    {"name": "stats", "command": ["pm-stats", "--verbose"]},
    {"name": "clearing", "command": ["pm-clearing", "--verbose"]},
    {"name": "engine", "command": ["pm-engine", "--verbose"]},
    {"name": "scheduler", "command": ["pm-scheduler", "--daily", "--verbose"]},
    {"name": "market-data", "command": ["pm-md-gwy", "--verbose"]},
    {"name": "post-trade", "command": ["pm-ralf-gwy", "--verbose"]},
    {"name": "drop-copy", "command": ["pm-dc-gwy", "--verbose"]},
    {"name": "api-desk", "command": ["pm-api-gwy", "--verbose", "--instance", "desk"]},
    {
        "name": "api-dashboards",
        "command": ["pm-api-gwy", "--verbose", "--instance", "dashboards"],
    },
    {"name": "alf", "command": ["pm-alf-gwy", "--verbose"]},
